  "cards": [
    {
      "dot": "cyan",
      "title": "Borde y sesion",
      "items": [
        "Cloudflare (DNS · SSL · WAF) delante de Render; trustProxy = 2 por los dos saltos",
        "helmet, hpp, CORS por lista blanca, rate limit 1500/15 min y 20/15 min en auth",
        "JWT access 15 min + refresh 7 d en cookies httpOnly firmadas"
      ]
    },
    {
      "dot": "emerald",
      "title": "Aplicacion",
      "items": [
        "Express 5 con 23 routers bajo /api/* y validacion express-validator en las rutas",
        "Controladores delgados; los services concentran Factus, suscripciones, OAuth y email"
      ]
    },
    {
      "dot": "rose",
      "title": "Multi-tenant y datos",
      "items": [
        "tenantGuard rechaza por hooks toda query sin filtro por clinicaId; excepciones con sinTenant: true",
        "PostgreSQL 16, UUID como PK y campos sensibles cifrados con keyring versionado",
        "Migraciones al arranque y jobs de limpieza de tokens y logs cada 24 h"
      ]
    }
  ]
