  "cards": [
    {
      "dot": "cyan",
      "title": "Raiz del tenant",
      "items": [
        "clinicas es la raiz; suscripciones e integraciones_facturacion cuelgan de ella",
        "26 de las 31 tablas llevan columna clinicaId y tenantGuard exige ese filtro en toda query",
        "Las otras 5 heredan el tenant del padre: factura_items, factura_compra_items y los 3 de tokens"
      ]
    },
    {
      "dot": "emerald",
      "title": "Cadena clinica",
      "items": [
        "propietarios → mascotas → citas → historias_clinicas es la espina del dominio",
        "antecedentes_mascota es 1:1 con mascota; examenes_laboratorio y registros_estilo cuelgan de mascota"
      ]
    },
    {
      "dot": "amber",
      "title": "Dinero e inventario",
      "items": [
        "factura_items y factura_compra_items apuntan a productos, insumos_clinicos y servicios_clinicos",
        "facturas, gastos y abonos se agrupan por caja_turnos para el cierre de caja",
        "gastos puede referenciar la historia clinica que consumio los insumos"
      ]
    }
  ]
