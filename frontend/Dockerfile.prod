FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_URL=https://api.bourgelat.co/api
ENV VITE_API_URL=$VITE_API_URL

ARG VITE_OAUTH_ENABLED=false
ENV VITE_OAUTH_ENABLED=$VITE_OAUTH_ENABLED

ARG VITE_OAUTH_MICROSOFT_ENABLED=false
ENV VITE_OAUTH_MICROSOFT_ENABLED=$VITE_OAUTH_MICROSOFT_ENABLED

RUN npm run build

FROM nginxinc/nginx-unprivileged:stable-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
